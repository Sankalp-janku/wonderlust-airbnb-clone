<% layout("./layouts/boilerplate") %>

<div class="row mt-3">
        <div class="col-6 offset-3">
            <form action="/signup" method="post" class="needs-validation" novalidate>

                <div class="mb-3">
            <label for="username" class="form-label txt">Username</label>
            <input type="text" 
            name="username" 
            
            class="form-control" 
            id="username" 
            required
            minlength="5"
             maxlength="100">
            <div class="valid-feedback">username looks good!</div> 
             <div class="invalid-feedback">invalid title!</div>
             
        </div>

            </form>
        </div>
</div>