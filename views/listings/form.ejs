<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wonderlust</title>
</head>
<body>
    <h2>Create a New Listing</h2>
    <form action="/listings/new" method="post">
        <input type="text" name="listing[title]" placeholder="enter title"><br><br>
         <textarea type="text" name="listing[description]" placeholder="enter description" rows="5" cols="50"></textarea> <br><br>
         <input type="text" name="listing[image]" placeholder="enter image link / url"><br><br>
          <input type="number" name="listing[price]" placeholder="enter price"><br><br>
            <input type="text" name="listing[country]" placeholder="enter country"><br><br>
            <input type="text" name="listing[location]" placeholder="enter location"><br><br>
             <button>submit</button>
    </form>
</body>
</html>