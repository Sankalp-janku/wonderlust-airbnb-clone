 <% layout("/layouts/boilerplate") %>
 <div class="row ">
    <div class="col-8 offset-3">
     <br><br><br><br><br>
    <h2><%= listing.title %></h2>
    </div>
    <div class=" card col-4 offset-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing-img"><br><br>
        <div class="card-body">
            
             <li><%= listing.description %></li>
            <li>&#8377;<%= listing.price.toLocaleString("en-IN") %></li>
            <li><%= listing.location %></li>
            <li><%= listing.country %></li>
       
        </div>
    </div>
 </div>

 <div class="btns">
    <a href="/listings/<%= listing._id %>/edit " class="btn btn-dark edit-btn" style="height: auto;">Edit Listing</a><br><br>
     <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
        <button class="  btn btn-dark delete-btn">Delete Listing</button>
    </form>
    </div>
    <hr>
    <div class="col-8 offset-3 mb-3  reviewBox">
      <h4 class="reviewHeading">Drop ur Valuable Feedback!!</h4>
      <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">   
        
         <!-- rating -->
         
         <div class="mb-3 mt-3">
            <label for="rating">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range reviewRange">
         </div>
         <!-- Comment -->
          <div class="mb-3 mt-3">
            <label for="comment" class="form-label"> comment</label><br>
            <textarea name="review[comment]" id="comment" cols="100"  class="form-control reviewText" required></textarea>
            <div class="invalid-feedback">plese add some kind of comments</div>
              
          </div>
          <button class="btn btn-outline-dark reviewBtn">Submit</button>
      </form>
      
      <p><b>All Reviews</b></p>
      <div class="row">
         <% for(review of listing.reviews){ %>
            <div class="card col-5 ms-3 mb-3 ">
               <div class="card-body">
                  <h5 class="card-title">John Deo</h5>
                  <p class="card-text"><%= review.comment %></p>
                  <p class="card-text"><%= review.rating %> stars</p>
               </div>
               <form  method="post"action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3" >
                  <button class="btn btn-sm btn-dark">delete</button>
               </form>
            </div>
         <%} %>
      </div>
    </div>
    
 </div>
 
 
 

 
 